{
  "api": {
    "title": "TAMS API",
    "version": "8.0",
    "description": "Time-addressable Media Store API"
  },
  
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "debug": false,
    "workers": 4
  },
  
  "database": {
    "vast": {
      "endpoint": "http://your-vast-endpoint:4001",
      "access_key": "YOUR_VAST_ACCESS_KEY",
      "secret_key": "YOUR_VAST_SECRET_KEY",
      "bucket": "your-bucket",
      "schema": "tams8"
    },
    "trino": {
      "host": "trino-host",
      "port": 8080,
      "user": "admin",
      "catalog": "vast",
      "enabled": true
    },
    "enable_table_projections": true
  },
  
  "storage_backends": [
    {
      "id": "default",
      "label": "default-s3-storage",
      "store_type": "http_object_store",
      "provider": "vast",
      "store_product": "vast-s3",
      "region": "us-east-1",
      "availability_zone": null,
      "endpoint_url": "http://your-s3-endpoint:4001",
      "access_key": "YOUR_S3_ACCESS_KEY",
      "secret_key": "YOUR_S3_SECRET_KEY",
      "bucket_name": "your-s3-bucket",
      "root_path": "/tams8",
      "use_ssl": false,
      "chunk_size": 8388608,
      "max_concurrent_parts": 10,
      "default_storage": true
    }
  ],
  
  "storage": {
    "default_backend_id": "default",
    "tams_storage_path": "tams",
    "tams_root": "/tams",
    "presigned_url": {
      "upload_timeout": 3600,
      "download_timeout": 3600
    },
    "get_urls_max_count": 5,
    "flow_storage_default_limit": 10,
    "segment_storage_default_limit": 10,
    "async_deletion_threshold": 1000
  },
  
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s:%(lineno)d - %(levelname)s - %(message)s"
  },
  
  "tams_compliance": {
    "enabled": true,
    "audit_logging": false
  },
  
  "cors": {
    "origins": ["*"],
    "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "headers": ["*"]
  },
  
  "auth": {
    "enabled": true,
    "jwt_secret": "CHANGE_THIS_IN_PRODUCTION",
    "jwt_algorithm": "HS256",
    "token_expiration": 3600,
    "refresh_token_expiration": 86400
  }
}

