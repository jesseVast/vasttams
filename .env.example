# TAMS API Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# Server Settings
# =============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=false

# =============================================================================
# VAST Database Settings
# =============================================================================
VAST_ENDPOINT=http://main.selab-var204.selab.vastdata.com
VAST_ACCESS_KEY=SRSPW0DQT9T70Y787U68
VAST_SECRET_KEY=WkKLxvG7YkAdSMuHjFsZG5/BhDk9Ou7BS1mDQGnr
VAST_BUCKET=jthaloor-db
VAST_SCHEMA=tams

# Trino settings for vaststore SQL capabilities
TRINO_HOST=docker1
TRINO_PORT=8080
TRINO_USER=admin
TRINO_CATALOG=vast

# VastStore settings
VASTSTORE_ENABLE_TRINO=true
VASTSTORE_S3_CHUNK_SIZE=8388608
VASTSTORE_S3_MAX_CONCURRENT_PARTS=10

# =============================================================================
# S3 Storage Settings
# =============================================================================
S3_ENDPOINT_URL=http://main.selab-var204.selab.vastdata.com
S3_ACCESS_KEY_ID=SRSPW0DQT9T70Y787U68
S3_SECRET_ACCESS_KEY=WkKLxvG7YkAdSMuHjFsZG5/BhDk9Ou7BS1mDQGnr
S3_BUCKET_NAME=jthaloor-s3
S3_USE_SSL=false
S3_REGION=us-east-1

# Presigned URL configuration
S3_PRESIGNED_URL_UPLOAD_TIMEOUT=3600
S3_PRESIGNED_URL_DOWNLOAD_TIMEOUT=3600

# =============================================================================
# Authentication & Security
# =============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# Storage Configuration
# =============================================================================
STORAGE_TYPE=http_object_store
STORAGE_BASE_URL=https://storage.example.com
DEFAULT_STORAGE_BACKEND_ID=default
TAMS_STORAGE_PATH=tams
S3_TAMS_ROOT=/tams
GET_URLS_MAX_COUNT=5

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s:%(lineno)d - %(levelname)s - %(message)s

# =============================================================================
# Webhook Settings
# =============================================================================
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_ATTEMPTS=3

# =============================================================================
# TAMS Compliance Settings
# =============================================================================
TAMS_COMPLIANCE_MODE=true
TAMS_VALIDATION_LEVEL=strict

# Validation settings
ENABLE_UUID_VALIDATION=true
ENABLE_TIMESTAMP_VALIDATION=true
ENABLE_CONTENT_FORMAT_VALIDATION=true
ENABLE_MIME_TYPE_VALIDATION=true

# Error handling
TAMS_ERROR_REPORTING=true
TAMS_AUDIT_LOGGING=true

# =============================================================================
# Performance Settings
# =============================================================================
TAMS_CACHE_ENABLED=true
TAMS_CACHE_TTL=300
ENABLE_TABLE_PROJECTIONS=false

# API limits
TAMS_FLOW_STORAGE_DEFAULT_LIMIT=10
TAMS_SEGMENT_STORAGE_DEFAULT_LIMIT=10
TAMS_ASYNC_DELETION_THRESHOLD=1000

# =============================================================================
# Telemetry and Observability
# =============================================================================
JAEGER_ENDPOINT=localhost:14268
OTLP_ENDPOINT=http://localhost:4318/v1/traces
TELEMETRY_ENABLED=true
METRICS_ENABLED=true
TRACING_ENABLED=true
