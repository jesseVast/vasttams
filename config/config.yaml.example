# TAMS (Time-addressable Media Store) Configuration
# This file supports comments for documentation and clarity
# YAML format is recommended over JSON for better readability and comment support

api:
  title: "TAMS API"
  version: "8.0"
  description: "Time-addressable Media Store API"

server:
  host: "0.0.0.0"  # Listen on all interfaces (use 127.0.0.1 for localhost only)
  port: 8000
  debug: false  # Should be false in production for security and performance
  workers: 1  # Set to 1 for single-process mode (development), higher for production (default: 4)

database:
  vast:
    # REQUIRED: VAST database endpoint URL
    # Must be set or application will fail to start
    # Format: http://hostname:port
    endpoint: "http://docker1:4003"
    # Optional: Separate endpoint for vector operations (vastdbmanager 1.1.10+)
    # If not set, vector operations will use the main endpoint
    # vector_endpoint: "http://docker1:4004"
    access_key: "SRSPW0DQT9T70Y787U68"
    secret_key: "WkKLxvG7YkAdSMuHjFsZG5/BhDk9Ou7BS1mDQGnr"
    bucket: "jthaloor-db"
    schema: "tams8"
  
  trino:
    host: "docker1"
    port: 8080
    user: "admin"
    catalog: "vast"
    enabled: true
  
  enable_table_projections: true

storage_backends:
  - id: "default"
    label: "default-s3-storage"
    store_type: "http_object_store"
    provider: "vast"
    store_product: "vast-s3"
    region: "us-east-1"
    availability_zone: null
    endpoint_url: "http://docker1:4002"
    access_key: "SRSPW0DQT9T70Y787U68"
    secret_key: "WkKLxvG7YkAdSMuHjFsZG5/BhDk9Ou7BS1mDQGnr"
    bucket_name: "jthaloor-s3"
    root_path: "/tams8"
    use_ssl: false
    chunk_size: 8388608  # 8MB chunks for multipart uploads
    max_concurrent_parts: 10
    default_storage: true

storage:
  default_backend_id: "default"
  tams_storage_path: "tams"
  tams_root: "/"
  presigned_url:
    upload_timeout: 3600  # 1 hour - matches cache TTL
    download_timeout: 3600  # 1 hour - matches cache TTL
  get_urls_max_count: 5
  flow_storage_default_limit: 10
  segment_storage_default_limit: 10
  async_deletion_threshold: 1000

logging:
  level: "INFO"  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
  format: "%(asctime)s - %(name)s:%(lineno)d - %(levelname)s - %(message)s"
  dir: "logs"

tams_compliance:
  enabled: true
  validation_level: "strict"  # Options: strict, moderate, lenient
  uuid_validation: true
  timestamp_validation: true
  content_format_validation: true
  mime_type_validation: true
  error_reporting: true
  audit_logging: true
  cache_enabled: true
  cache_ttl: 3600  # Matches presigned URL expiration (1 hour)

telemetry:
  enabled: true
  metrics_enabled: true
  tracing_enabled: true
  jaeger_endpoint: "localhost:14268"
  otlp_endpoint: "http://localhost:4318/v1/traces"

authentication:
  # WARNING: Change this secret key in production!
  secret_key: "your-secret-key-here-change-in-production"
  algorithm: "HS256"
  access_token_expire_minutes: 30

webhooks:
  timeout: 30  # seconds
  retry_attempts: 3

redis:
  enabled: true
  host: "docker1"
  port: 6379
  password: null  # Set password if Redis requires authentication
  db: 0
  ssl: false
  socket_timeout: 5
  socket_connect_timeout: 5
  max_connections: 50
  health_check_interval: 30  # seconds

vector_search:
  default_num_matches: 10  # Default number of matches to return for vector search
  default_distance_metric: "cosine"  # Options: cosine, euclidean, dot_product
  default_distance_numerical_value: 0.75  # Default distance threshold (0.75 for cosine)

embedding:
  # Embedding provider configuration
  # Use jthaloor-ai embedder library for embedding generation
  # See ~/Developer/gitlab/jthaloor-ai for supported providers and options
  # Supported providers via jthaloor-ai: ollama, nim, openai, gemini, nvidia
  provider: "jthaloor-ai"  # Use jthaloor-ai library (maps to actual provider via endpoint/model)
  endpoint: "http://10.143.2.16:11434"  # Base URL for embedding service (Ollama example)
  model_name: "bge-m3:latest"  # Embedding model name (provider-specific)
  model_dimension: 1024  # Embedding model dimension (vector size) - depends on model
  distance_algorithm: "cosine"  # Default distance algorithm (cosine, euclidean, dot_product)
  default_distance_threshold: 0.8  # Default distance threshold for embedding-based search
  api_key_env: "EMBEDDING_API_KEY"  # Environment variable name for embedding API key
  timeout: 120  # Embedding request timeout in seconds
  retry_count: 3  # Number of retry attempts for embedding requests
  # Provider-specific settings (optional)
  provider_config:
    # Provider type is inferred from endpoint URL, but can be explicitly set:
    # provider: "ollama"  # Options: ollama, nim, openai, gemini, nvidia
    # 
    # Example configurations:
    # 
    # Ollama (local):
    #   endpoint: "http://10.143.2.16:11434"
    #   model_name: "bge-m3:latest"
    #   provider: "ollama"
    # 
    # NVIDIA NIM:
    #   endpoint: "http://10.143.2.16:8000"
    #   model_name: "bge-m3"
    #   provider: "nim"
    # 
    # OpenAI:
    #   endpoint: "https://api.openai.com"
    #   model_name: "text-embedding-ada-002"
    #   provider: "openai"
    #   api_key_env: "OPENAI_API_KEY"
    # 
    # Google Gemini:
    #   endpoint: "https://generativelanguage.googleapis.com"
    #   model_name: "text-embedding-004"
    #   provider: "gemini"
    #   api_key_env: "GEMINI_API_KEY"
    # 
    # NVIDIA DGX Cloud:
    #   endpoint: "https://integrate.api.nvidia.com"
    #   model_name: "bge-m3"
    #   provider: "nvidia"
    #   api_key_env: "NVIDIA_API_KEY"

