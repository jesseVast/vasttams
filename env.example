# TAMS API Environment Configuration

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# VAST store settings
VAST_DATA_DIR=./vast_data

# VAST Database settings
VAST_ENDPOINT=http://vast.example.com:4002
VAST_ACCESS_KEY=your-vast-access-key-here
VAST_SECRET_KEY=your-vast-secret-key-here
VAST_BUCKET=your-vast-bucket-name
VAST_SCHEMA=tams8

# Trino settings for vaststore SQL capabilities
# Note: Trino connector configuration is in docker/vast.properties
TRINO_HOST=trino.example.com
TRINO_PORT=8080
TRINO_USER=admin
TRINO_CATALOG=vast

# VastStore settings
VASTSTORE_ENABLE_TRINO=true
VASTSTORE_S3_CHUNK_SIZE=8388608
VASTSTORE_S3_MAX_CONCURRENT_PARTS=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Security (change in production)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage settings
STORAGE_TYPE=http_object_store
STORAGE_BASE_URL=https://storage.example.com

# Webhook settings
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_ATTEMPTS=3

# S3 settings for flow segment storage
S3_ENDPOINT_URL=http://s3.example.com:9000
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_NAME=your-s3-bucket-name
S3_USE_SSL=false

# Presigned URL configuration - Runtime configurable
S3_PRESIGNED_URL_UPLOAD_TIMEOUT=3600
S3_PRESIGNED_URL_DOWNLOAD_TIMEOUT=3600

# Storage backend configuration for get_urls
DEFAULT_STORAGE_BACKEND_ID=default

# get_urls configuration
GET_URLS_MAX_COUNT=5

# Table projections configuration for improved query performance
ENABLE_TABLE_PROJECTIONS=false

# TAMS API Compliance settings
TAMS_COMPLIANCE_MODE=true
TAMS_VALIDATION_LEVEL=strict

# TAMS-specific validation settings
ENABLE_UUID_VALIDATION=true
ENABLE_TIMESTAMP_VALIDATION=true
ENABLE_CONTENT_FORMAT_VALIDATION=true
ENABLE_MIME_TYPE_VALIDATION=true

# TAMS error handling settings
TAMS_ERROR_REPORTING=true
TAMS_AUDIT_LOGGING=true

# TAMS performance settings
TAMS_CACHE_ENABLED=true
TAMS_CACHE_TTL=300

# Storage API limits
TAMS_FLOW_STORAGE_DEFAULT_LIMIT=10
TAMS_SEGMENT_STORAGE_DEFAULT_LIMIT=10
TAMS_ASYNC_DELETION_THRESHOLD=1000

# Telemetry and Observability
JAEGER_ENDPOINT=localhost:14268
OTLP_ENDPOINT=http://localhost:4318/v1/traces
TELEMETRY_ENABLED=true
METRICS_ENABLED=true
TRACING_ENABLED=true

# Redis Cache Configuration
TAMS_REDIS_ENABLED=true
TAMS_REDIS_HOST=localhost
TAMS_REDIS_PORT=6379
TAMS_REDIS_PASSWORD=
TAMS_REDIS_DB=0
TAMS_REDIS_SSL=false
TAMS_REDIS_SOCKET_TIMEOUT=5
TAMS_REDIS_SOCKET_CONNECT_TIMEOUT=5
TAMS_REDIS_MAX_CONNECTIONS=50
TAMS_REDIS_HEALTH_CHECK_INTERVAL=30